<% content_for :header_title, "Gestão de Terceiros" %>
<% content_for :header_desc, "Convide uma nova empresa para o processo de Due Diligence." %>

<article class="card card--auth"> 
  <div class="card__header">
    <h2 class="card__title">Convidar Empresa</h2>
  </div>

  <%= ui_form_feedback %>

  <%= form_with url: admin_diligence_invitations_path, method: :post, class: "report-form" do |f| %>
    
    <%= ui_text_input f, :razao_social, label: "Razão Social", placeholder: "Nome Oficial da Empresa", autofocus: true %>

    <%= ui_text_input f, :cnpj, label: "CNPJ", placeholder: "00.000.000/0001-00", 
        data: { controller: "mask", mask_type: "cnpj" } %>

    <%= ui_email_input f, :email, label: "E-mail do Responsável", placeholder: "contato@empresa.com" %>
    <small class="form-hint">As credenciais de acesso serão enviadas para este endereço.</small>

    <div class="report-form__footer">
      <%= ui_submit f, "Enviar Convite e Criar Acesso" %>
      
    </div>
  <% end %>
</article>