<% content_for :header_title, "Relato Enviado com Sucesso" %>
<% content_for :header_desc, "Sua denúncia foi registrada em nosso sistema." %>

<article class="card card--auth" data-controller="clipboard">
  <p class="text-muted" style="font-size: 0.85rem; margin-bottom: 1.5rem;">
    <strong>Atenção:</strong> Anote ou copie o código abaixo para acompanhar seu relato anonimamente.
  </p>

  <%= ui_highlight_card do %>
    <%# Protocolo %>
    <%= ui_card_label "Seu Protocolo" %>
    <%= ui_card_value @report.protocolo, data: { clipboard_target: "source" } %>
    
    <button type="button" class="button button--outline" style="width: 100%;" data-action="click->clipboard#copy">
      <span data-clipboard-target="buttonText">Copiar Código</span>
    </button>

    <%= ui_card_divider %>

    <%# Nome %>
    <div style="margin-bottom: 1.5rem;">
      <%= ui_card_label "Nome do Relator" %>
      <%= ui_card_value(@report.nome.presence || "Anônimo", size: "1.1rem") %>
    </div>

    <%# Descrição %>
    <div>
      <%= ui_card_label "Descrição Enviada" %>
      <%= ui_card_content @report.descricao %>
    </div>
  <% end %>

  <footer class="report-form__footer" style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 2rem;">
    <%= link_to "Ver Painel de Relatos", reports_path, class: "button button--primary text-center" if Current.user %>
    <%= link_to "Consultar Protocolo", lookup_reports_path, class: "button button--outline text-center" %>
    <%= link_to "Voltar ao Início", root_path, class: "button button--outline text-center" %>
  </footer>
</article>