<% content_for :header_title, "Acesso Restrito" %>
<% content_for :header_desc, "Área exclusiva para membros autorizados da empresa." %>

<article class="card card--auth">
  <div class="card__header">
    <h2 class="card__title">Identifique-se</h2>
  </div>

  <%= ui_form_feedback %>

  <%= form_with url: session_path, class: "report-form" do |form| %>
    

    <%= ui_email_input form, :email_address, label: "E-mail Corporativo", autofocus: true %>


    <%= ui_password_input form, :password, label: "Senha" %>

    <div class="report-form__footer">
      <%= form.submit "Entrar no Sistema", class: "button button--primary" %>
    </div>
  <% end %>
</article>