<article class="card">
  <div class="card__header">
    <h2 class="card__title">Atualizar Senha</h2>
  </div>


  <%= ui_form_feedback(@user) %>

  <%= form_with model: @user, url: password_path(token: params[:token]), method: :patch, class: "report-form" do |f| %>
    <%= ui_password_input f, :password, label: "Nova Senha", show_rules: true %>
    <%= ui_password_input f, :password_confirmation, label: "Confirme a Senha" %>

    <div class="report-form__footer">
      <%= f.submit "Salvar e Acessar Sistema", class: "button button--primary", style: "width: 100%;" %>
    </div>
  <% end %>
</article>